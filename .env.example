# Telegram Configuration
TELEGRAM_TOKEN=your_telegram_bot_token_here
# Alternative name for backward compatibility:
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 🌟 Oracle Server Local OmniRoute (Optional - if running on your Oracle VPS)
# When deployed on Oracle host directly:
# OMNIROUTE_BASE=http://localhost:20128/v1
# When deployed in Docker/Coolify on the same Oracle host:
# OMNIROUTE_BASE=http://host.docker.internal:20128/v1
# OMNIROUTE_KEY=sk-531aab8980af0e5a-7eba2f-22a14bc8
# OMNIROUTE_MODEL=auto

# External Providers (Optional - fallback order: Venice -> OpenRouter -> Pollinations)
VENICE_KEY=your_venice_api_key_here
OPENROUTER_KEY=your_openrouter_api_key_here

# Webhook URL (Only needed if using Webhooks; leave commented for standard long-polling)
# WEBHOOK_URL=https://your-domain-or-ip
